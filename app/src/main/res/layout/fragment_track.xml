<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollTrack"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_soft"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- Header Layar -->
        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status &amp; Lacak Pesanan"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrackSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pantau progres pembuatan roti Anda secara langsung"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- KARTU UTAMA: PESANAN AKTIF ANDA (Otomatis Muncul Teratas) -->
        <LinearLayout
            android:id="@+id/cardTrackingDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_product_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Baris Header Kartu: Label & Metode Pengiriman -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTrackSectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PESANAN AKTIF ANDA"
                    android:textColor="@color/primary_caramel"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Badge Metode Pengiriman (Ambil di Toko vs Diantar) -->
                <TextView
                    android:id="@+id/tvTrackDeliveryMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_category"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="Ambil di Toko"
                    android:textColor="@color/primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Kode Pesanan & Badge Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTrackDetailCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ORD-20261009-0001"
                    android:textColor="@color/primary_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Indikator Realtime Firestore -->
                <TextView
                    android:id="@+id/tvRealtimeIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_success"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="● Realtime"
                    android:textColor="@color/status_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvTrackDetailStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pending"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="Menunggu Konfirmasi"
                    android:textColor="@color/status_amber"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border_soft" />

            <!-- STEPPER TIMELINE STATUS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tahapan Pemrosesan Roti"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_badge_category"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Step 1: Pesanan Diterima -->
                <LinearLayout
                    android:id="@+id/stepPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStep1Icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_circle" />

                    <TextView
                        android:id="@+id/tvStep1Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="1. Pesanan Diterima Toko"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Step 2: Sedang Dipanggang -->
                <LinearLayout
                    android:id="@+id/stepProcess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStep2Icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_clock" />

                    <TextView
                        android:id="@+id/tvStep2Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="2. Roti Sedang Dipanggang &amp; Dikemas"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Step 3: Siap Diambil / Diantar (Dinamis Berdasarkan Metode) -->
                <LinearLayout
                    android:id="@+id/stepCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStep3Icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_bakery_item" />

                    <TextView
                        android:id="@+id/tvStep3Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="3. Roti Siap Diambil di Outlet Toko"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- INFORMASI RINCIAN PESANAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTrackDetailCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pemesan: Farhan Zalfanudin (08123456789)"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTrackDetailAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Lokasi: Outlet Erles Bakery - Jl. Mayor Bismo No. 27 Kediri"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTrackDetailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Jadwal: Jumat, 9 Oktober 2026 (10:00 WIB)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTrackDetailNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Catatan: Tulisan ucapan selamat ulang tahun"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp"
                    android:textStyle="italic" />

                <!-- BARIS STATUS & PEMBAYARAN -->
                <LinearLayout
                    android:id="@+id/layoutPaymentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_badge_category"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Tagihan Pesanan"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTrackDetailTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 85.000"
                                android:textColor="@color/primary_dark"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Badge Status Pembayaran (Belum Bayar vs LUNAS) -->
                        <TextView
                            android:id="@+id/tvTrackPaymentBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pending"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Belum Dibayar"
                            android:textColor="@color/status_red"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Tombol Bayar Sekarang (Aktif bila belum lunas) -->
                    <Button
                        android:id="@+id/btnPayOrder"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button_primary"
                        android:drawableStart="@drawable/ic_payment"
                        android:drawablePadding="8dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Bayar Sekarang (QRIS / Transfer BCA)"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Indikator Ketika Sudah Lunas -->
                    <LinearLayout
                        android:id="@+id/layoutPaymentPaidNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_badge_success"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Lunas"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/status_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Pembayaran Lunas telah diverifikasi oleh Kasir."
                            android:textColor="@color/status_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- #20, #26 & #33: Bukti transfer kamera, galeri, dan storage -->
                    <LinearLayout
                        android:id="@+id/layoutUploadProofSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnUploadPaymentProof"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_button_secondary"
                            android:text="Unggah Bukti Transfer (Kamera / Galeri)"
                            android:textAllCaps="false"
                            android:textColor="@color/primary_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            android:id="@+id/pbUploadProof"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="6dp"
                            android:visibility="gone" />

                        <!-- Container Pratinjau Foto Bukti Pembayaran dari Supabase -->
                        <LinearLayout
                            android:id="@+id/layoutProofPreview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_product_card"
                            android:orientation="vertical"
                            android:padding="8dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvProofStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bukti Transfer Tersimpan di Supabase Storage:"
                                android:textColor="@color/status_green"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ivProofThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="170dp"
                                android:layout_marginTop="6dp"
                                android:background="#F5F5F5"
                                android:contentDescription="Bukti Transfer Supabase"
                                android:scaleType="centerCrop" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/border_soft" />

            <!-- #25: QR-Code tiket kasir -->
            <LinearLayout
                android:id="@+id/layoutQrCodeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIKET QR CODE PENGAMBILAN KASIR"
                    android:textColor="@color/primary_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivOrderQrCode"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/white"
                    android:contentDescription="QR Code Tiket Pesanan"
                    android:padding="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tunjukkan QR ini ke kasir outlet Erles Bakery saat pengambilan roti."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- #22: Tombol Lihat Lokasi Outlet di Peta OSM -->
                <Button
                    android:id="@+id/btnViewBakeryLocation"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_map"
                    android:drawablePadding="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Petunjuk Arah Outlet di Peta OSM"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_dark"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- SEKSI KHUSUS DELIVERY: INFORMASI PENGANTARAN KURIR -->
            <LinearLayout
                android:id="@+id/layoutDeliveryInfoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_process"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENGANTARAN OLEH KURIR TOKO"
                    android:textColor="@color/status_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeliveryHomeAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Alamat Tujuan: Perumahan Indah Blok C No. 12 Kediri"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Roti akan diantar langsung oleh kurir ke alamat Anda sesuai jam pesanan. Mohon pastikan nomor WhatsApp Anda aktif."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- #22: Tombol Lihat Rute Pengantaran di Peta OSM -->
                <Button
                    android:id="@+id/btnViewDeliveryRoute"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_map"
                    android:drawablePadding="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Lihat Rute Pengantaran di Peta OSM"
                    android:textAllCaps="false"
                    android:textColor="@color/status_blue"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- TOMBOL AKSI: HUBUNGI VIA WHATSAPP -->
            <Button
                android:id="@+id/btnContactKasirWa"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:drawableStart="@drawable/ic_whatsapp"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Hubungi Kasir via WhatsApp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- TOMBOL BATALKAN PESANAN (Khusus saat status masih 'pending') -->
            <Button
                android:id="@+id/btnCancelOrder"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_delete"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Batalkan Pesanan Ini"
                android:textAllCaps="false"
                android:textColor="@color/status_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- DAFTAR SEMUA RIWAYAT PESANAN (SQLite orders_history) -->
        <TextView
            android:id="@+id/tvHistoryHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Riwayat Pesanan Anda"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryHeaderCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Semua pesanan yang pernah Anda buat di perangkat ini"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Container Kartu Riwayat Dinamis -->
        <LinearLayout
            android:id="@+id/layoutOrdersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Tampilan Kosong Jika Belum Ada Pesanan -->
        <LinearLayout
            android:id="@+id/layoutHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_product_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_bakery_item" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Belum Ada Riwayat Pesanan"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Pesanan yang Anda buat melalui keranjang belanja akan otomatis muncul dan dapat dilacak di sini."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
