<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Info Modul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#EFF6FF"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PML 14 - Kriptografi AES (Pertemuan 11)"
                android:textStyle="bold"
                android:textColor="#1E40AF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D3 Manajemen Informatika Kampus Kediri\nAlgoritma: AES/CBC/PKCS5PADDING"
                android:textColor="#3B82F6"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- KARTU ENKRIPSI (KUNING) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewEncrypt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFEB3B"
            app:cardCornerRadius="10dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. PROSES ENKRIPSI (PLAIN -> CIPHER)"
                    android:textStyle="bold"
                    android:textColor="#5D4037"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/edPlainText"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="#FFFFFF"
                    android:gravity="top|start"
                    android:hint="Masukkan teks yang akan di enkripsi"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="#000000"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edSecretKey"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="#FFFFFF"
                    android:hint="Masukkan secret key (16/24/32 karakter)"
                    android:inputType="text"
                    android:padding="10dp"
                    android:text="Qwertyui87651234"
                    android:textColor="#000000"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEncrypt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#4A148C"
                    android:text="ENCRYPT"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edEncryptedText"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    android:background="#FFF9C4"
                    android:gravity="top|start"
                    android:hint="Text terenkripsi (Ciphertext Base64)"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- KARTU DEKRIPSI (CYAN / BIRU) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardViewDecrypt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#00BCD4"
            app:cardCornerRadius="10dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. PROSES DEKRIPSI (CIPHER -> PLAIN)"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/edSecretKey2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="#FFFFFF"
                    android:hint="Masukkan secret key (16/24/32 karakter)"
                    android:inputType="text"
                    android:padding="10dp"
                    android:text="Qwertyui87651234"
                    android:textColor="#000000"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDecrypt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#4A148C"
                    android:text="DECRYPT"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edDecryptedText"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginTop="12dp"
                    android:background="#E0F7FA"
                    android:gravity="top|start"
                    android:hint="Teks terdekripsi (Plaintext hasil)"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="#000000"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tombol Tutup / Kembali -->
        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#475569"
            android:text="Kembali ke Aplikasi Utama"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>

