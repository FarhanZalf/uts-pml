<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_product_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Baris Utama: Gambar, Nama, Harga Satuan, dan Tombol Hapus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Foto Roti -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_badge_category"
            android:padding="8dp">

            <ImageView
                android:id="@+id/ivCartProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto Roti"
                android:src="@drawable/ic_bakery_item" />
        </FrameLayout>

        <!-- Nama & Harga Satuan -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Butter Croissant Klasik"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCartPricePerPcs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rp 18.000 / pcs"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Catatan khusus jika ada -->
            <TextView
                android:id="@+id/tvCartNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_badge_category"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="Catatan: Potong jadi 2"
                android:textColor="@color/primary_dark"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tombol Hapus Cepat -->
        <ImageButton
            android:id="@+id/btnCartDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hapus item"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/border_soft" />

    <!-- Baris Bawah: Quantity Stepper & Subtotal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Stepper Kuantitas -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_qty_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnCartMinus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_stepper_btn"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="-"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCartQuantity"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCartPlus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_stepper_btn"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="+"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtotal Item -->
        <TextView
            android:id="@+id/tvCartSubtotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Rp 18.000"
            android:textColor="@color/primary_caramel"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
