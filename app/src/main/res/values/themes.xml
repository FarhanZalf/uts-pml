<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Uts" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_caramel</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/secondary_cream</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/background_soft</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background_soft</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Uts" parent="Base.Theme.Uts" />
</resources>